{
    "name": "spryker-demo/product-archiving",
    "type": "library",
    "description": "Product Archiving module",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "rentpost/propel2-soft-delete-behavior": "^1.0.5",
        "spryker/kernel": "^3.73.0",
        "spryker/product": "^6.37.0",
        "spryker/product-list": "^1.7.1",
        "spryker/sales": "^11.40.5",
        "spryker/shopping-list": "^4.16.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*"
    },
    "autoload": {
        "psr-4": {
            "SprykerDemo\\": "src/SprykerDemo/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerDemoTest\\": "tests/SprykerDemoTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": {
        "spryker-demo-propel-soft-delete-behavior": {
            "type": "vcs",
            "url": "https://github.com/spryker-projects/propel2-soft-delete-behavior.git"
        }
    }
}
